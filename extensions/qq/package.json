{
  "name": "@openclaw/qq",
  "version": "2026.3.9",
  "description": "OpenClaw QQ channel plugin (via go-cqhttp)",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "zod": "^4.3.6"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "qq",
      "label": "QQ",
      "selectionLabel": "QQ (via go-cqhttp)",
      "docsPath": "/channels/qq",
      "docsLabel": "qq",
      "blurb": "QQ 即时通讯 (通过 go-cqhttp 中转)",
      "aliases": [
        "qq-bot"
      ],
      "order": 90,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@openclaw/qq",
      "localPath": "extensions/qq",
      "defaultChoice": "npm"
    }
  }
}
